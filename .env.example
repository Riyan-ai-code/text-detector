# TruthLens AI Platform Configuration
PROJECT_NAME="TruthLens AI"
VERSION="2.1.0"
DEBUG=True
HOST="127.0.0.1"
PORT=8000

# Security & JWT Auth
SECRET_KEY="generate_a_secure_random_jwt_secret_key_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./truthlens.db"
# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
# For Local Docker PostgreSQL + pgvector:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/truthlens"

# Supabase Cloud Storage (Optional)
SUPABASE_URL=""
SUPABASE_KEY=""
SUPABASE_STORAGE_BUCKET="truthlens-uploads"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
